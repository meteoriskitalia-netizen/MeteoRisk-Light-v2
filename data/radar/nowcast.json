ia", "nowcast_csi": 0.3513, "persistence_csi": 0.2852, "csi_delta": 0.066, "nowcast_fss": 0.3958, "persistence_fss": 0.3468, "fss_delta": 0.049, "nowcast_beats_persistence": true, "low_reliability": false}, "hf_restore": {"applied": true, "null_reason": null, "lambda": 0.652588, "level": 0.7, "growth_per_90min": 0.2, "sigma_px": 4.0, "hf_before": 0.76405168, "hf_after": 1.71258104}, "stats": {"max_mmh": 26.43, "mean_mmh": 0.0505, "rain_pixels": 31430, "rain_area_km2": 31430.0, "area_by_threshold_km2": {"0.5": 17529.0, "2.0": 5615.0, "5.0": 1776.0}, "published_pixels": 691730}}], "grid": {"crs": "EPSG:3857", "bounds": [504349.918, 4173378.794, 2278637.352, 6081022.777], "width": 1183, "height": 1272, "resolution_m": 1500.0, "bbox_lonlat": [4.53065, 35.06986, 20.46935, 47.84449]}, "legend": [{"mmh": 0.3, "rgb": [0, 220, 255]}, {"mmh": 2.0, "rgb": [0, 150, 255]}, {"mmh": 5.0, "rgb": [0, 220, 110]}, {"mmh": 10.0, "rgb": [255, 235, 0]}, {"mmh": 20.0, "rgb": [255, 140, 0]}, {"mmh": 50.0, "rgb": [255, 40, 40]}, {"mmh": 100.0, "rgb": [240, 0, 210]}], "motion_pair_dt_s": [300.0], "motion_stats": {"median_speed_kmh": 30.13, "p95_speed_kmh": 55.62, "pixels_over_cap": 1000, "pixels_over_cap_total": 3190}, "limits": "Trasporto puro: nessuna crescita/decadimento fisico dell'intensita'. Il flusso ottico stima il moto a 2 km; il trasporto avviene su una griglia di 3 km (media a blocchi) e viene riportato a 1 km, per non produrre bordi frastagliati e nastri. Il dettaglio fine (<4 km) viene ripristinato con un unsharp DETERMINISTICO alla varianza alto-pass dell'analisi: non e' rumore e non crea pioggia dove il trasporto e' asciutto. Il nowcast si ferma a +90 minuti: oltre, il rapporto d'aspetto delle strutture supera 1,5x l'osservato (misurato 1,73x a +120). Il moto e' regolarizzato togliendo la componente divergente sotto 100 km (Helmholtz + low-pass): traslazione e rotazione restano, la deformazione a scala di cella no. La massa totale non cresce (la crescita numerica del ricampion