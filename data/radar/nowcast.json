i": 0.3513, "persistence_csi": 0.2852, "csi_delta": 0.066, "nowcast_fss": 0.3958, "persistence_fss": 0.3468, "fss_delta": 0.049, "nowcast_beats_persistence": true, "low_reliability": false}, "hf_restore": {"applied": true, "null_reason": null, "lambda": 0.595459, "level": 0.7, "growth_per_90min": 0.2, "sigma_px": 4.0, "hf_before": 0.3286798, "hf_after": 0.68309069}, "stats": {"max_mmh": 13.24, "mean_mmh": 0.0264, "rain_pixels": 21373, "rain_area_km2": 21373.0, "area_by_threshold_km2": {"0.5": 10996.0, "2.0": 2999.0, "5.0": 560.0}, "published_pixels": 691730}}], "grid": {"crs": "EPSG:3857", "bounds": [504349.918, 4173378.794, 2278637.352, 6081022.777], "width": 1183, "height": 1272, "resolution_m": 1500.0, "bbox_lonlat": [4.53065, 35.06986, 20.46935, 47.84449]}, "legend": [{"mmh": 0.3, "rgb": [0, 220, 255]}, {"mmh": 2.0, "rgb": [0, 150, 255]}, {"mmh": 5.0, "rgb": [0, 220, 110]}, {"mmh": 10.0, "rgb": [255, 235, 0]}, {"mmh": 20.0, "rgb": [255, 140, 0]}, {"mmh": 50.0, "rgb": [255, 40, 40]}, {"mmh": 100.0, "rgb": [240, 0, 210]}], "motion_pair_dt_s": [300.0], "motion_stats": {"median_speed_kmh": 24.04, "p95_speed_kmh": 56.61, "pixels_over_cap": 612, "pixels_over_cap_total": 2291}, "limits": "Trasporto puro: nessuna crescita/decadimento fisico dell'intensita'. Il flusso ottico stima il moto a 2 km; il trasporto avviene su una griglia di 3 km (media a blocchi) e viene riportato a 1 km, per non produrre bordi frastagliati e nastri. Il dettaglio fine (<4 km) viene ripristinato con un unsharp DETERMINISTICO alla varianza alto-pass dell'analisi: non e' rumore e non crea pioggia dove il trasporto e' asciutto. Il nowcast si ferma a +90 minuti: oltre, il rapporto d'aspetto delle strutture supera 1,5x l'osservato (misurato 1,73x a +120). Il moto e' regolarizzato togliendo la componente divergente sotto 100 km (Helmholtz + low-pass): traslazione e rotazione restano, la deformazione a scala di cella no. La massa totale non cresce (la crescita numerica del ricampionamento viene rimossa; il decadimento reale non e' modellato). La maschera e' quella del dominio radar: fuori non viene disegnato nulla.", "orographic_enhancement": {"schema": "meteorisk.orography_enhancement/1", "enabled": false, "applied": false, "null_reason": "disabled_by_config", "applied_to": "transported_field_per_lead_before_alpha_and_stats", "params": {"min_mean_elev_m": 20.0, "rh_threshold": 0.8, "min_upslope_ms": 0.0005, "upwind_km": 15.0, "lee_floor_frac": 0.5, "max_relative_increase": 1.0, "wind_level": "10m", "rain_min_mmh": 0.05, "grid_file": "data/geography/orography_it_0p05.json", "rv": 461.5}, "limits": "Correzione ADDITIVA limitata dalla formula (nessun moltiplicatore scelto a occhio), applicata solo dove la precipitazione trasportata e' >= 0,05 mm/h: non crea pioggia dove il radar non vede nulla. TETTO dichiarato: il termine positivo non puo' superare il campo trasportato (`max_relative_increase` = 1.0, cioe' al massimo +100%): senza tetto la formula aggiunge fino a 32 mm/h su un pixel con 0,3 mm/h, che non e' un enhancement ma pioggia inventata. I pixel in cui il tetto morde sono contati (`capped_pixels`). Sottovento l'attenuazione non scende sotto il 50% del campo trasportato (limite ingegneristico dichiarato). Quota = DEM SRTM 0,05 deg (non un modello NWP ne' le centraline). Formula Alpert & Shafir nata per QPE, trasposta al nowcast: NON validata.", "reference": "Alpert & Shafir 1989 (enhancement orografico, formulazione IMPROVER/STEPS); Magnus/Tetens per e_s. Trasposizione ingegneristica al nowcast, NON validata."}, "ensemble": {"schema": "meteorisk.nowcast_ensemble/1", "enabled": true, "applied": true, "null_reason": null, "method": "motion_perturbation+nonparametric_band_noise", "members": 20, "thresholds_mmh": [0.5, 2.0, 5.0, 10.0, 20.0], "reference": "Perturbazione del moto e disegno a 20 membri: STEPS/BPS (Bowler, Pierce & Seed 2006, QJRMS 132:1149; Germann et al. 2006, MWR 134:2838) - +-10,88 m/s paralleli e +-5,76 m/s perpendicolari, CITATI. Rumore per ba