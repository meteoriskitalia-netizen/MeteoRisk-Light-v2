ast_lead065.webp":{"name":"nowcast_lead065.webp","bytes":32722,"sha256":"8fe9efec6a5b0923ac5c85a5794ed08a079ef6f7b3fbf9f3f04187fd1d8ef0c9","present":true},"nowcast_lead070.webp":{"name":"nowcast_lead070.webp","bytes":32794,"sha256":"0c71713092695b5d01a74347e6e0f569f88cdcc396dbda8b7edd5cd94b00a78e","present":true},"nowcast_lead075.webp":{"name":"nowcast_lead075.webp","bytes":32786,"sha256":"c629b6d5a9d0fe431bfad7f47646274123b2d39e7c3f8822ec6fdd7a7ef062ca","present":true},"nowcast_lead080.webp":{"name":"nowcast_lead080.webp","bytes":32568,"sha256":"a90a4c80fcb77b97f549d8049005093d100c60c68b29438939371cc8bf9b7839","present":true},"nowcast_lead085.webp":{"name":"nowcast_lead085.webp","bytes":32458,"sha256":"94064a9920dc56f45bf3463d05228ff9bb04159e05ca8b6cf9e4660f9a45a41b","present":true},"nowcast_lead090.webp":{"name":"nowcast_lead090.webp","bytes":32396,"sha256":"3d31b90fded7067eb8a36b2759479907a6ef79627f2082b3771730efd72c9e41","present":true}},"limits":"Trasporto puro: nessuna crescita/decadimento fisico dell'intensita'. Il flusso ottico stima il moto a 2 km; il trasporto avviene su una griglia di 3 km (media a blocchi) e viene riportato a 1 km, per non produrre bordi frastagliati e nastri. Il dettaglio fine (<4 km) viene ripristinato con un unsharp DETERMINISTICO alla varianza alto-pass dell'analisi: non e' rumore e non crea pioggia dove il trasporto e' asciutto. Il nowcast si ferma a +90 minuti: oltre, il rapporto d'aspetto delle strutture supera 1,5x l'osservato (misurato 1,73x a +120). Il moto e' regolarizzato togliendo la componente divergente sotto 100 km (Helmholtz + low-pass): traslazione e rotazione restano, la deformazione a scala di cella no. La massa totale non cresce (la crescita numerica del ricampionamento viene rimossa; il decadimento reale non e' modellato). La maschera e' quella del dominio radar: fuori non viene disegnato nulla."}